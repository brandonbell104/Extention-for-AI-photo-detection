{
  "manifest_version": 3,
  "name": "Image Noise Pattern Analyzer",
  "version": "1.0",
  "description": "Visualizes sensor noise patterns in images to detect potential manipulation",
  "permissions": ["activeTab", "storage", "sidePanel", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Open Image Noise Analyzer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
